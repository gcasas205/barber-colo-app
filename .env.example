# Copiá este archivo a .env.local y completá los valores. Nunca subas .env.local.

# Conexión del servidor a Postgres con el rol app_server (spec 001).
# Local (npm run db:start): la contraseña de app_server se pone con
#   alter role app_server password '...';   (solo en tu base local)
DATABASE_URL=postgresql://app_server:CAMBIAR@127.0.0.1:54332/postgres
# Producción: pooler de Supabase en modo transacción (puerto 6543), usuario app_server.<project-ref>.
# DATABASE_URL=postgresql://app_server.ohfedpyxtowaeaafemkb:CAMBIAR@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# El certificado raíz de Supabase ya viene en el código (src/shared/db/supabase-ca.ts).
# Solo si Supabase lo rota: DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."

# Login con Google (spec 002).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
